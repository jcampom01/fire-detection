        <mxCell id="results" value="results/" style="shape=folder;tabWidth=40;tabHeight=12;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="105" width="110" height="50" as="geometry" />
