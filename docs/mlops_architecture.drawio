    <diagram name="4. Una predicción" id="predict">
        <mxGraphModel dx="1514" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" math="0" shadow="0">
            <root>
                <mxCell id="predict-0"/>
                <mxCell id="predict-1" parent="predict-0"/>
                <mxCell id="predict-t1" parent="predict-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" value="&lt;b&gt;El recorrido de una predicción&lt;/b&gt;" vertex="1">
                    <mxGeometry height="30" width="1400" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="predict-t2" parent="predict-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" value="La API prepara la foto exactamente como el dataset de entrenamiento; TF Serving solo decodifica y predice" vertex="1">
